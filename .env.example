# Скопируйте этот файл в .env.local и вставьте значения из Supabase:
# Project Settings → API (или кнопка Connect → App Frameworks → Next.js)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (sb_publishable_…) или anon key — подойдёт любой из двух
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Telegram-бот: присылает новые заказы и заявки на консультацию.
# Токен выдаёт @BotFather. Держите его в секрете — не коммитьте.
TELEGRAM_BOT_TOKEN=
# Кому слать: chat id через запятую. Узнать — Админка → Настройки → «Найти чаты»
TELEGRAM_CHAT_ID=

# Письма покупателям через Gmail: адрес и пароль приложения (myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# SEO. Адрес сайта для Google, sitemap и превью ссылок. Пусто — на Vercel берётся адрес проекта
# (health-matrix.vercel.app). Когда будет свой домен — впишите его: https://example.md
NEXT_PUBLIC_SITE_URL=
# Подтверждение сайта в Google Search Console: метод «HTML-тег», значение content="…" из тега
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
